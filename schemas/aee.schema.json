{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valeriolombardi.github.io/governed-ai-pa/schemas/aee.schema.json",
  "title": "PICEE-PA Administrative Execution Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aee_id",
    "purpose",
    "requester",
    "agent",
    "capability",
    "action_class",
    "policy"
  ],
  "properties": {
    "aee_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "process": {
      "type": "string"
    },
    "requester": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "human",
            "service",
            "system"
          ]
        }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sponsor": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "delegation": {
      "type": "object",
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": [
        "action",
        "resource"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "data_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "action_class": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "approval": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}